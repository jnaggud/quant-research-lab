//@version=6
strategy("JD Velocity TV Native v2", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.0, slippage=0, process_orders_on_close=true)

direction = input.string("Long + short", "Direction", options=["Long only", "Long + short"])
htf = input.timeframe("1D", "Regime timeframe")
useDateRange = input.bool(false, "Use date range")
startTime = input.time(1672531200000, "Start")
endTime = input.time(4102444800000, "End")

emaFastLen = input.int(21, "Fast EMA", minval=1)
emaSlowLen = input.int(55, "Slow EMA", minval=1)
emaRegimeLen = input.int(200, "Regime EMA", minval=1)
adxLen = input.int(14, "ADX length", minval=1)
adxFloor = input.float(12.0, "ADX floor", step=0.5)
normLen = input.int(50, "Normalization length", minval=5)
oscSmoothLen = input.int(3, "ARWO smoothing", minval=1)
aroonLen = input.int(25, "Aroon length", minval=2)
breakoutLen = input.int(28, "Breakout length", minval=2)
cooldownBars = input.int(8, "Cooldown bars", minval=0)

atrLen = input.int(14, "ATR length", minval=1)
initialStopAtr = input.float(8.0, "Initial stop ATR", step=0.1)
trailActivationAtr = input.float(14.0, "Trail activation ATR", step=0.1)
trailAtr = input.float(8.0, "Trail ATR", step=0.1)
exitOnLocalBear = input.bool(false, "Exit on local bear")
showSignals = input.bool(true, "Show signals")

f_safe_div(a, b) => math.abs(b) > 1e-10 ? a / b : 0.0
f_clip(x, lo, hi) => math.max(lo, math.min(hi, x))
f_norm_minmax(src, len) =>
    lowest = ta.lowest(src, len)
    highest = ta.highest(src, len)
    f_clip(2.0 * f_safe_div(src - lowest, highest - lowest) - 1.0, -1.0, 1.0)
f_williams(len) => -100.0 * f_safe_div(ta.highest(high, len) - close, ta.highest(high, len) - ta.lowest(low, len))
f_aroon_osc(len) =>
    highBars = ta.highestbars(high, len + 1)
    lowBars = ta.lowestbars(low, len + 1)
    aroonUp = 100.0 * (len - math.abs(highBars)) / len
    aroonDown = 100.0 * (len - math.abs(lowBars)) / len
    aroonUp - aroonDown

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaRegime = ta.ema(close, emaRegimeLen)
[_, _, adx] = ta.dmi(adxLen, adxLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
rsi = ta.rsi(close, 14)
atr = ta.atr(atrLen)

rocNorm = f_norm_minmax(ta.roc(close, 10), normLen)
macdNorm = f_norm_minmax(macdHist, normLen)
aroonNorm = f_aroon_osc(aroonLen) / 100.0
trendComponent = (rocNorm + macdNorm + aroonNorm) / 3.0
rsiNorm = (rsi - 50.0) / 50.0
stochNorm = (ta.stoch(close, high, low, 14) - 50.0) / 50.0
willNorm = (f_williams(14) + 50.0) / 50.0
reversionComponent = (rsiNorm + stochNorm + willNorm) / 3.0
arwoRaw = f_clip(adx / 100.0, 0.0, 1.0) * trendComponent + (1.0 - f_clip(adx / 100.0, 0.0, 1.0)) * reversionComponent
arwo = f_clip(ta.sma(arwoRaw, oscSmoothLen), -1.0, 1.0)
velocity = arwo - arwo[1]

htfClose = request.security(syminfo.tickerid, htf, close, barmerge.gaps_off, barmerge.lookahead_off)
htfEmaFast = request.security(syminfo.tickerid, htf, ta.ema(close, emaSlowLen), barmerge.gaps_off, barmerge.lookahead_off)
htfEmaRegime = request.security(syminfo.tickerid, htf, ta.ema(close, emaRegimeLen), barmerge.gaps_off, barmerge.lookahead_off)
htfBull = htfClose > htfEmaRegime and htfEmaFast > htfEmaRegime
htfBear = htfClose < htfEmaRegime and htfEmaFast < htfEmaRegime

inRange = not useDateRange or (time >= startTime and time <= endTime)
localBull = close > emaRegime and emaFast > emaSlow and adx >= adxFloor
localBear = close < emaRegime and emaFast < emaSlow and adx >= adxFloor
trendCrossLong = ta.crossover(emaFast, emaSlow)
trendCrossShort = ta.crossunder(emaFast, emaSlow)
velocityLong = ta.crossover(arwo, 0) or (velocity > 0 and arwo > arwo[1] and arwo < 0.35)
velocityShort = ta.crossunder(arwo, 0) or (velocity < 0 and arwo < arwo[1] and arwo > -0.35)
breakoutLong = close > ta.highest(high, breakoutLen)[1] and macdHist > 0
breakoutShort = close < ta.lowest(low, breakoutLen)[1] and macdHist < 0

var int lastTradeBar = na
barsSinceTrade = na(lastTradeBar) ? 100000 : bar_index - lastTradeBar
canTrade = inRange and barsSinceTrade >= cooldownBars
longSignal = canTrade and htfBull and localBull and (trendCrossLong or velocityLong or breakoutLong)
shortSignal = canTrade and direction == "Long + short" and htfBear and localBear and (trendCrossShort or velocityShort or breakoutShort)

if longSignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
    lastTradeBar := bar_index
if shortSignal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
    lastTradeBar := bar_index

longStop = strategy.position_avg_price - atr * initialStopAtr
shortStop = strategy.position_avg_price + atr * initialStopAtr
trailPoints = atr * trailAtr / syminfo.mintick
trailOffset = atr * trailActivationAtr / syminfo.mintick
strategy.exit("Long Risk Exit", "Long", stop=longStop, trail_points=trailPoints, trail_offset=trailOffset)
strategy.exit("Short Risk Exit", "Short", stop=shortStop, trail_points=trailPoints, trail_offset=trailOffset)

if strategy.position_size > 0 and ((exitOnLocalBear and localBear) or not htfBull or (useDateRange and time > endTime))
    strategy.close("Long")
if strategy.position_size < 0 and ((exitOnLocalBear and localBull) or not htfBear or (useDateRange and time > endTime))
    strategy.close("Short")

plot(emaFast, "Fast EMA", color=color.new(color.aqua, 0))
plot(emaSlow, "Slow EMA", color=color.new(color.orange, 0))
plot(emaRegime, "Regime EMA", color=color.new(color.white, 20), linewidth=2)
bgcolor(htfBull ? color.new(color.green, 92) : htfBear ? color.new(color.red, 92) : na)
plotshape(showSignals and longSignal, "Long", shape.triangleup, location.belowbar, color=color.lime, size=size.tiny, text="L")
plotshape(showSignals and shortSignal, "Short", shape.triangledown, location.abovebar, color=color.red, size=size.tiny, text="S")
