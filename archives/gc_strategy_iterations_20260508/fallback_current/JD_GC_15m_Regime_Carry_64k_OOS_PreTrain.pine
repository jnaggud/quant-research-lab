//@version=6
strategy("JD GC 15m Regime Carry 64k OOS PreTrain", overlay=true, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, margin_long=5, margin_short=5, commission_type=strategy.commission.cash_per_contract, commission_value=2.50, slippage=1, process_orders_on_close=true)

// Source: reports/gc_15m_regime_carry_64k.json
// Objective: out-of-sample test before the Sep 30, 2025 – May 7, 2026 optimization range.
// Engine: high-exposure H4 regime carry with ATR trailing risk and shorting enabled.
h4FastLen = input.int(9, "4H fast EMA", minval=1)
h4SlowLen = input.int(37, "4H slow EMA", minval=1)
dFastLen = input.int(13, "Daily fast EMA", minval=1)
dSlowLen = input.int(34, "Daily slow EMA", minval=1)
regimeMode = input.string("h4", "Regime mode", options=["both", "h4", "h4_daily_veto"])
localFilter = input.string("ema55", "Local filter", options=["none", "ema21", "ema55", "stack", "ema144"])
stopAtr = input.float(5.4956, "Hard stop ATR", step=0.1)
trailAtr = input.float(12.6935, "Trail stop ATR", step=0.1)
cooldownBars = input.int(6, "Cooldown bars", minval=0)
longRsiMin = input.float(57.8685, "Long RSI min", step=0.1)
shortRsiMax = input.float(54.1336, "Short RSI max", step=0.1)
macdFloor = input.float(-3.2882, "MACD floor", step=0.1)
volMult = input.float(0.2568, "Volume multiplier", step=0.01)
useMomentumExit = input.bool(true, "Use momentum exit")
longExitRsi = input.float(39.9573, "Long momentum exit RSI", step=0.1)
shortExitRsi = input.float(43.7398, "Short momentum exit RSI", step=0.1)
longExitRegime = input.int(0, "Long exit regime", minval=-1, maxval=0)
shortExitRegime = input.int(0, "Short exit regime", minval=0, maxval=1)
allowShorts = input.bool(true, "Allow shorts")
useDateRange = input.bool(true, "Use optimization date range")
startTime = input.time(1751241600000, "Start")
endTime = input.time(1759190399000, "End")
showSignals = input.bool(true, "Show signals")
showMtfLines = input.bool(true, "Show MTF EMAs")

h4Fast = request.security(syminfo.tickerid, "240", ta.ema(close, h4FastLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
h4Slow = request.security(syminfo.tickerid, "240", ta.ema(close, h4SlowLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
dFast = request.security(syminfo.tickerid, "1D", ta.ema(close, dFastLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
dSlow = request.security(syminfo.tickerid, "1D", ta.ema(close, dSlowLen)[1], barmerge.gaps_off, barmerge.lookahead_off)

h4Signal = h4Fast > h4Slow ? 1 : -1
dailySignal = dFast > dSlow ? 1 : -1
regime = regimeMode == "both" ? (h4Signal == dailySignal ? h4Signal : 0) : regimeMode == "h4" ? h4Signal : (dailySignal == -h4Signal ? 0 : h4Signal)
inRange = not useDateRange or (time >= startTime and time <= endTime)

rsi = ta.rsi(close, 14)
[_, _, macdHist] = ta.macd(close, 12, 26, 9)
atr = ta.atr(14)
ema8 = ta.ema(close, 8)
ema21 = ta.ema(close, 21)
ema55 = ta.ema(close, 55)
ema144 = ta.ema(close, 144)
volSma = ta.sma(volume, 48)

longFilter = localFilter == "none" ? true : localFilter == "ema21" ? close > ema21 : localFilter == "ema55" ? close > ema55 : localFilter == "stack" ? ema8 > ema21 and ema21 > ema55 and close > ema8 : close > ema144
shortFilter = localFilter == "none" ? true : localFilter == "ema21" ? close < ema21 : localFilter == "ema55" ? close < ema55 : localFilter == "stack" ? ema8 < ema21 and ema21 < ema55 and close < ema8 : close < ema144
volOk = volume >= volMult * volSma
longSetup = inRange and regime == 1 and longFilter and rsi >= longRsiMin and macdHist >= macdFloor and volOk
shortSetup = inRange and allowShorts and regime == -1 and shortFilter and rsi <= shortRsiMax and macdHist <= -macdFloor and volOk

var int lastExitBar = na
var float entryHigh = na
var float entryLow = na
flatNow = strategy.position_size == 0 and strategy.position_size[1] != 0
if flatNow
    lastExitBar := bar_index
    entryHigh := na
    entryLow := na
cooldownOk = na(lastExitBar) or bar_index - lastExitBar >= cooldownBars
canEnter = strategy.position_size == 0 and cooldownOk

if canEnter and longSetup
    strategy.entry("Long", strategy.long)
    entryHigh := high
    entryLow := low
else if canEnter and shortSetup
    strategy.entry("Short", strategy.short)
    entryHigh := high
    entryLow := low

if strategy.position_size != 0
    entryHigh := na(entryHigh) ? high : math.max(entryHigh, high)
    entryLow := na(entryLow) ? low : math.min(entryLow, low)

longStop = math.max(strategy.position_avg_price - stopAtr * atr, entryHigh - trailAtr * atr)
shortStop = math.min(strategy.position_avg_price + stopAtr * atr, entryLow + trailAtr * atr)

if strategy.position_size > 0
    strategy.exit("Long Risk", "Long", stop=longStop)
if strategy.position_size < 0
    strategy.exit("Short Risk", "Short", stop=shortStop)
if strategy.position_size > 0 and (not inRange or regime <= longExitRegime)
    strategy.close("Long", comment="Regime exit")
if strategy.position_size < 0 and (not inRange or regime >= shortExitRegime)
    strategy.close("Short", comment="Regime exit")
if strategy.position_size > 0 and useMomentumExit and macdHist < macdHist[1] and rsi < longExitRsi
    strategy.close("Long", comment="Momentum exit")
if strategy.position_size < 0 and useMomentumExit and macdHist > macdHist[1] and rsi > shortExitRsi
    strategy.close("Short", comment="Momentum exit")

plot(showMtfLines ? h4Fast : na, "4H Fast EMA prev", color=color.new(color.aqua, 0))
plot(showMtfLines ? h4Slow : na, "4H Slow EMA prev", color=color.new(color.orange, 0))
plot(showMtfLines ? dFast : na, "Daily Fast EMA prev", color=color.new(color.lime, 60), linewidth=2)
plot(showMtfLines ? dSlow : na, "Daily Slow EMA prev", color=color.new(color.red, 60), linewidth=2)
plot(strategy.position_size > 0 ? longStop : na, "Long active stop", color=color.new(color.red, 0), style=plot.style_linebr)
plot(strategy.position_size < 0 ? shortStop : na, "Short active stop", color=color.new(color.lime, 0), style=plot.style_linebr)
plotshape(showSignals and longSetup, "Long setup", shape.circle, location.belowbar, color=color.new(color.lime, 0), size=size.tiny, text="L")
plotshape(showSignals and shortSetup, "Short setup", shape.circle, location.abovebar, color=color.new(color.fuchsia, 0), size=size.tiny, text="S")
bgcolor(regime == 1 ? color.new(color.green, 92) : regime == -1 ? color.new(color.red, 94) : color.new(color.gray, 94))
