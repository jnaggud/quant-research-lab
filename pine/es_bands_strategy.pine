//@version=5
// ES Stretch-Band Strategy — z-score reversion/momentum bands, matching the Python
// research (quant/reversion_bands.py). Momentum mode (go WITH the stretch) was the
// profitable variant OOS (+47%, PF 1.12); Reversion mode (fade) loses — both included
// so you can see it on the chart. Bands are MA ± k·σ (the "fixed vertical size" bands
// in sigma space, drawn around the moving average).
strategy("ES Stretch-Band Strategy", overlay=true, initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=2.5,
     slippage=1, pyramiding=0)

// ---- inputs ----
maLen   = input.int(96,   "MA length (bars)", minval=5)
sigEnt  = input.float(1.0, "Signal sigma (|z| threshold)", step=0.25)
mode    = input.string("Momentum", "Mode", options=["Momentum", "Reversion"])
longOnly= input.bool(false, "Long only")
stopPts = input.float(40.0, "Stop (points)", step=5)
tpPts   = input.float(40.0, "Target (points)", step=5)
showBands = input.bool(true, "Show sigma bands")

// ---- stretch (causal) ----
basis = ta.sma(close, maLen)
dev   = ta.stdev(close, maLen)
z     = dev > 0 ? (close - basis) / dev : 0.0

// ---- bands (MA ± 1/2/3 sigma) ----
b1u = basis + dev,  b1d = basis - dev
b2u = basis + 2*dev, b2d = basis - 2*dev
b3u = basis + 3*dev, b3d = basis - 3*dev
pMA = plot(showBands ? basis : na, "MA", color=color.new(color.gray, 0), linewidth=1)
p1u = plot(showBands ? b1u : na, "+1s", color=color.new(color.teal, 60))
p1d = plot(showBands ? b1d : na, "-1s", color=color.new(color.teal, 60))
p2u = plot(showBands ? b2u : na, "+2s", color=color.new(color.orange, 60))
p2d = plot(showBands ? b2d : na, "-2s", color=color.new(color.orange, 60))
p3u = plot(showBands ? b3u : na, "+3s", color=color.new(color.red, 50))
p3d = plot(showBands ? b3d : na, "-3s", color=color.new(color.red, 50))
fill(p1u, p1d, color=color.new(color.teal, 92), title="±1s")
fill(p2u, p1u, color=color.new(color.orange, 92), title="+1..+2s")
fill(p1d, p2d, color=color.new(color.orange, 92), title="-1..-2s")
fill(p3u, p2u, color=color.new(color.red, 92), title="+2..+3s")
fill(p2d, p3d, color=color.new(color.red, 92), title="-2..-3s")

// ---- signals ----
momo = mode == "Momentum"
longCond  = momo ? (z >= sigEnt)  : (z <= -sigEnt)
shortCond = momo ? (z <= -sigEnt) : (z >= sigEnt)
if longOnly
    shortCond := false

// ---- execution ----
if longCond and strategy.position_size <= 0
    strategy.entry("L", strategy.long)
if shortCond and strategy.position_size >= 0 and not longOnly
    strategy.entry("S", strategy.short)
// flat-out the opposite when long-only and signal flips down
if longOnly and shortCond and strategy.position_size > 0
    strategy.close("L")

// stops / targets (points -> price)
strategy.exit("Lx", from_entry="L", stop=strategy.position_avg_price - stopPts, limit=strategy.position_avg_price + tpPts)
strategy.exit("Sx", from_entry="S", stop=strategy.position_avg_price + stopPts, limit=strategy.position_avg_price - tpPts)

// ---- markers ----
plotshape(longCond,  "long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.tiny)
plotshape(shortCond, "short", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.tiny)
