//@version=6
strategy("JD ES 15m Trend Reversal Short 64k 20260508", overlay=true, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, margin_long=5, margin_short=5, commission_type=strategy.commission.cash_per_contract, commission_value=2.50, slippage=1, process_orders_on_close=true)

// Source: reports/es_15m_trend_reversal_short_force_trend_64k_min150_max1500.json
// Tuned on TradingView CME_MINI_DL:ES1! 15m bars from Sep 30, 2025 through May 7, 2026.
// ES-specific engine: BTC reversal base + trend-continuation entries + shorting.
h4FastLen = input.int(12, "4H fast EMA", minval=1)
h4SlowLen = input.int(64, "4H slow EMA", minval=1)
dFastLen = input.int(21, "Daily fast EMA", minval=1)
dSlowLen = input.int(76, "Daily slow EMA", minval=1)
entryScoreMin = input.int(2, "Reversal entry score", minval=1, maxval=5)
exitScoreMin = input.int(4, "Opposite reversal exit score", minval=1, maxval=5)
stochLow = input.float(43.7888, "Stoch valley max", step=0.1)
stochHigh = input.float(67.2550, "Stoch peak min", step=0.1)
rsiLow = input.float(39.4785, "RSI valley max", step=0.1)
rsiHigh = input.float(65.5675, "RSI peak min", step=0.1)
willrLow = input.float(-83.5644, "Williams valley max", step=0.1)
willrHigh = input.float(-17.6827, "Williams peak min", step=0.1)
bbMult = input.float(1.8030, "Bollinger mult", step=0.01)
atrDisplace = input.float(1.7911, "ATR displacement", step=0.01)
pullbackLookback = input.int(4, "Trend pullback lookback", minval=1)
pullbackAtr = input.float(0.2897, "Trend pullback ATR", step=0.01)
trendRsiLong = input.float(59.1003, "Trend long RSI min", step=0.1)
trendRsiShort = input.float(35.4891, "Trend short RSI max", step=0.1)
volMult = input.float(0.9050, "Trend volume multiplier", step=0.01)
stopAtr = input.float(1.5299, "Stop ATR", step=0.1)
reversalTargetAtr = input.float(4.2325, "Reversal target ATR", step=0.1)
trendTargetAtr = input.float(13.8951, "Trend target ATR", step=0.1)
cooldownBars = input.int(42, "Cooldown bars", minval=0)
allowShorts = input.bool(true, "Allow shorts")
useReversal = input.bool(true, "Use reversal entries")
useTrend = input.bool(true, "Use trend entries")
useDateRange = input.bool(true, "Use optimization date range")
startTime = input.time(1759190400000, "Start")
endTime = input.time(1778198399000, "End")
showSignals = input.bool(true, "Show signals")
showMtfLines = input.bool(true, "Show MTF EMAs")

h4Fast = request.security(syminfo.tickerid, "240", ta.ema(close, h4FastLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
h4Slow = request.security(syminfo.tickerid, "240", ta.ema(close, h4SlowLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
dFast = request.security(syminfo.tickerid, "1D", ta.ema(close, dFastLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
dSlow = request.security(syminfo.tickerid, "1D", ta.ema(close, dSlowLen)[1], barmerge.gaps_off, barmerge.lookahead_off)

h4Signal = h4Fast > h4Slow ? 1 : -1
dailySignal = dFast > dSlow ? 1 : -1
regime = h4Signal == dailySignal ? h4Signal : 0
longRegime = regime == 1
shortRegime = regime == -1
inRange = not useDateRange or (time >= startTime and time <= endTime)

rsi = ta.rsi(close, 14)
stochK = ta.stoch(close, high, low, 14)
stochD = ta.sma(stochK, 3)
willr = -100.0 * (ta.highest(high, 14) - close) / math.max(ta.highest(high, 14) - ta.lowest(low, 14), syminfo.mintick)
[_, _, macdHist] = ta.macd(close, 12, 26, 9)
atr = ta.atr(14)
basis = ta.sma(close, 20)
dev = bbMult * ta.stdev(close, 20)
bbUpper = basis + dev
bbLower = basis - dev
ema8 = ta.ema(close, 8)
ema21 = ta.ema(close, 21)
ema55 = ta.ema(close, 55)
volSma = ta.sma(volume, 48)

stochUp = ta.crossover(stochK, stochD)
stochDown = ta.crossunder(stochK, stochD)
rsiUp40 = ta.crossover(rsi, 40)
rsiDown60 = ta.crossunder(rsi, 60)
willrUp80 = ta.crossover(willr, -80)
willrDown20 = ta.crossunder(willr, -20)

valleyScore = 0
valleyScore += stochUp and stochK < stochLow ? 1 : 0
valleyScore += ((rsi < rsiLow and rsi > rsi[1]) or rsiUp40) ? 1 : 0
valleyScore += (willrUp80 or (willr < willrLow and willr > willr[1])) ? 1 : 0
valleyScore += ((low <= bbLower) or (close < basis - atrDisplace * atr)) ? 1 : 0
valleyScore += (macdHist < 0 and macdHist > macdHist[1]) ? 1 : 0

peakScore = 0
peakScore += stochDown and stochK > stochHigh ? 1 : 0
peakScore += ((rsi > rsiHigh and rsi < rsi[1]) or rsiDown60) ? 1 : 0
peakScore += (willrDown20 or (willr > willrHigh and willr < willr[1])) ? 1 : 0
peakScore += ((high >= bbUpper) or (close > basis + atrDisplace * atr)) ? 1 : 0
peakScore += (macdHist > 0 and macdHist < macdHist[1]) ? 1 : 0

pullbackLow = ta.lowest(low, pullbackLookback)
pullbackHigh = ta.highest(high, pullbackLookback)
trendLong = longRegime and ema8 > ema21 and ema21 > ema55 and pullbackLow <= ema21 + pullbackAtr * atr and close > ema8 and rsi > trendRsiLong and macdHist > macdHist[1] and volume >= volMult * volSma
trendShort = shortRegime and ema8 < ema21 and ema21 < ema55 and pullbackHigh >= ema21 - pullbackAtr * atr and close < ema8 and rsi < trendRsiShort and macdHist < macdHist[1] and volume >= volMult * volSma
reversalLong = longRegime and valleyScore >= entryScoreMin
reversalShort = shortRegime and peakScore >= entryScoreMin

var int lastExitBar = na
var int entryKind = 0
flatNow = strategy.position_size == 0 and strategy.position_size[1] != 0
if flatNow
    lastExitBar := bar_index
    entryKind := 0
cooldownOk = na(lastExitBar) or bar_index - lastExitBar >= cooldownBars

canEnter = inRange and strategy.position_size == 0 and cooldownOk
longTrendEntry = canEnter and useTrend and trendLong
longReversalEntry = canEnter and not longTrendEntry and useReversal and reversalLong
shortTrendEntry = canEnter and allowShorts and not longTrendEntry and not longReversalEntry and useTrend and trendShort
shortReversalEntry = canEnter and allowShorts and not longTrendEntry and not longReversalEntry and not shortTrendEntry and useReversal and reversalShort

if longTrendEntry
    strategy.entry("Long", strategy.long)
    entryKind := 2
else if longReversalEntry
    strategy.entry("Long", strategy.long)
    entryKind := 1
else if shortTrendEntry
    strategy.entry("Short", strategy.short)
    entryKind := 2
else if shortReversalEntry
    strategy.entry("Short", strategy.short)
    entryKind := 1

activeTargetAtr = entryKind == 2 ? trendTargetAtr : reversalTargetAtr
if strategy.position_size > 0
    strategy.exit("Long Risk", "Long", stop=strategy.position_avg_price - stopAtr * atr, limit=strategy.position_avg_price + activeTargetAtr * atr)
if strategy.position_size < 0
    strategy.exit("Short Risk", "Short", stop=strategy.position_avg_price + stopAtr * atr, limit=strategy.position_avg_price - activeTargetAtr * atr)
if strategy.position_size > 0 and peakScore >= exitScoreMin
    strategy.close("Long", comment="Peak exit")
if strategy.position_size < 0 and valleyScore >= exitScoreMin
    strategy.close("Short", comment="Valley exit")
if strategy.position_size > 0 and (not inRange or regime <= 0)
    strategy.close("Long", comment="Regime exit")
if strategy.position_size < 0 and (not inRange or regime >= 0)
    strategy.close("Short", comment="Regime exit")

plot(showMtfLines ? h4Fast : na, "4H Fast EMA prev", color=color.new(color.aqua, 0))
plot(showMtfLines ? h4Slow : na, "4H Slow EMA prev", color=color.new(color.orange, 0))
plot(showMtfLines ? dFast : na, "Daily Fast EMA prev", color=color.new(color.lime, 55), linewidth=2)
plot(showMtfLines ? dSlow : na, "Daily Slow EMA prev", color=color.new(color.red, 55), linewidth=2)
plot(bbUpper, "Peak band", color=color.new(color.red, 82))
plot(bbLower, "Valley band", color=color.new(color.lime, 82))
plotshape(showSignals and valleyScore >= entryScoreMin, "Valley setup", shape.circle, location.belowbar, color=color.new(color.lime, 0), size=size.tiny, text="V")
plotshape(showSignals and peakScore >= entryScoreMin, "Peak setup", shape.circle, location.abovebar, color=color.new(color.red, 0), size=size.tiny, text="P")
plotshape(showSignals and trendLong, "Trend long setup", shape.diamond, location.belowbar, color=color.new(color.aqua, 0), size=size.tiny, text="T")
plotshape(showSignals and trendShort, "Trend short setup", shape.diamond, location.abovebar, color=color.new(color.orange, 0), size=size.tiny, text="T")
plotshape(showSignals and (longTrendEntry or longReversalEntry), "Long", shape.triangleup, location.belowbar, color=color.lime, size=size.small, text="L")
plotshape(showSignals and (shortTrendEntry or shortReversalEntry), "Short", shape.triangledown, location.abovebar, color=color.fuchsia, size=size.small, text="S")
bgcolor(regime == 1 ? color.new(color.green, 92) : regime == -1 ? color.new(color.red, 94) : color.new(color.gray, 94))
